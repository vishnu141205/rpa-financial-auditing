gument x:TypeArguments="x:Double"><VisualBasicReference x:TypeArguments="x:Double" ExpressionText="grpB" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Double"><VisualBasicValue x:TypeArguments="x:Double" ExpressionText="Double.Parse(in_Ledger.Select(&quot;IsIntercompany = &#x27;true&#x27; AND TxnId = &#x27;&quot; &amp; icTxn &amp; &quot;&#x27;&quot;)(1)(&quot;Amount&quot;).ToString, System.Globalization.CultureInfo.InvariantCulture) * Double.Parse(in_Companies.Select(&quot;CompanyId = &#x27;&quot; &amp; coB &amp; &quot;&#x27;&quot;)(0)(&quot;FxToGroup&quot;).ToString, System.Globalization.CultureInfo.InvariantCulture)" /></InArgument></Assign.Value></Assign><Assign x:TypeArguments="x:Double" DisplayName="Intercompany variance %"><Assign.To><OutArgument x:TypeArguments="x:Double"><VisualBasicReference x:TypeArguments="x:Double" ExpressionText="icVar" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Double"><VisualBasicValue x:TypeArguments="x:Double" ExpressionText="Math.Round(Math.Abs(grpA - grpB) / Math.Max(grpA, grpB) * 100.0, 4)" /></InArgument></Assign.Value></Assign><Assign x:TypeArguments="x:Double" DisplayName="Intercompany tolerance (0 in Baseline)"><Assign.To><OutArgument x:TypeArguments="x:Double"><VisualBasicReference x:TypeArguments="x:Double" ExpressionText="icTol" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:Double"><VisualBasicValue x:TypeArguments="x:Double" ExpressionText="If(in_Ethical, Double.Parse(in_Companies.Rows(0)(&quot;IcTolerancePct&quot;).ToString, System.Globalization.CultureInfo.InvariantCulture), 0.0)" /></InArgument></Assign.Value></Assign><Assign x:TypeArguments="x:String" DisplayName="Set outcome"><Assign.To><OutArgument x:TypeArguments="x:String"><VisualBasicReference x:TypeArguments="x:String" ExpressionText="outcome" /></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="x:String"><VisualBasicValue x:TypeArguments="x:String" ExpressionTe